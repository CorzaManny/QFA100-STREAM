# Same Supabase project used by qfa100-dashboard (the pilot EFB).
# These are safe to expose client-side: VITE_SUPABASE_ANON_KEY is the
# publishable/anon key, not the service-role key. Row Level Security on the
# Supabase tables is what actually restricts what the overlays can read/write.
VITE_SUPABASE_URL=https://robydzjjanyhsmtjrhog.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-publishable-anon-key
